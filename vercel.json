{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/img/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, stale-while-revalidate=86400" }]
    },
    {
      "source": "/assets/(css|js)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    }
  ],
  "redirects": [
    { "source": "/projects", "destination": "/#work", "permanent": false },
    { "source": "/portrait.jpg", "destination": "/assets/img/portrait.jpg", "permanent": true },
    { "source": "/favicon.svg", "destination": "/assets/img/favicon.svg", "permanent": true },
    { "source": "/favicon.ico", "destination": "/assets/img/favicon.svg", "permanent": true },
    { "source": "/projects/:file([a-z0-9-]+)\\.(png|jpg|jpeg|webp)", "destination": "/assets/img/projects/:file.webp", "permanent": true }
  ]
}
